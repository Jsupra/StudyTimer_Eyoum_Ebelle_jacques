<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:StudyTimer.ViewModels"
             xmlns:models="clr-namespace:StudyTimer.Models"
             x:Class="StudyTimer.Views.StatsPage"
             BackgroundColor="#000000"
             Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <viewmodels:StatsViewModel />
    </ContentPage.BindingContext>

    <!-- Même séparation stricte que sur l'accueil : En-tête et Reste -->
    <Grid RowDefinitions="Auto, *">

        <!-- ======================================= -->
        <!-- 1. EN-TÊTE FIXE (Ligne 0)               -->
        <!-- ======================================= -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="*, Auto, *" 
              Padding="20, 15, 20, 10" 
              BackgroundColor="Transparent"
              ZIndex="1">

            <!-- Bouton Retour -->
            <Frame Grid.Column="0" 
                   BackgroundColor="#121212" 
                   CornerRadius="16" 
                   HeightRequest="32" 
                   WidthRequest="32" 
                   Padding="0" 
                   HasShadow="False" 
                   HorizontalOptions="Start" 
                   VerticalOptions="Center">
                <ImageButton Source="back_icon.svg" 
                             HeightRequest="12" 
                             WidthRequest="12" 
                             HorizontalOptions="Center" 
                             VerticalOptions="Center" 
                             BackgroundColor="Transparent" 
                             Clicked="OnBackClicked" />
            </Frame>

            <!-- Pilule Centrale (Logo + Titre "Statistiques") -->
            <Frame Grid.Column="1" BackgroundColor="#121212" CornerRadius="20" Padding="15,6" HasShadow="False" HorizontalOptions="Center" VerticalOptions="Center" BorderColor="Transparent">
                <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                    <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Image Source="studytimerlogo.svg" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"/>
                        <Label Text="StudyTimer" FontSize="12" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Statistiques" FontSize="9" TextColor="#A1A1AA" HorizontalOptions="Center" Margin="0,2,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Avatar Utilisateur -->
            <Frame Grid.Column="2" BackgroundColor="#121212" CornerRadius="16" HeightRequest="32" WidthRequest="32" Padding="0" HasShadow="False" HorizontalOptions="End" VerticalOptions="Center">
                <Image Source="avatar_placeholder.svg" HeightRequest="16" WidthRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
        </Grid>

        <!-- ======================================= -->
        <!-- 2. CONTENU + BARRE FLOTTANTE (Ligne 1)  -->
        <!-- ======================================= -->
        <Grid Grid.Row="1">

            <!-- LE CONTENU QUI DÉFILE -->
            <ScrollView Padding="20, 15, 20, 110">
                <VerticalStackLayout Spacing="25">

                    <!-- Titre de la page & Sélecteur -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="End">
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <BoxView Color="#4ADE80" WidthRequest="6" HeightRequest="6" CornerRadius="3" VerticalOptions="Center" />
                                <Label Text="SYNCHRONISATION" FontSize="10" FontAttributes="Bold" TextColor="#4ADE80" CharacterSpacing="1" />
                            </HorizontalStackLayout>
                            <Label Text="Statistiques de&#10;Révision" FontSize="24" FontAttributes="Bold" TextColor="White" LineHeight="1.1" />
                        </VerticalStackLayout>

                        <!-- Sélecteur de période -->
                        <Frame Grid.Column="1" BackgroundColor="#121212" CornerRadius="12" Padding="12,8" HasShadow="False" BorderColor="Transparent" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="{Binding SelectedPeriodText}" FontSize="11" TextColor="#A1A1AA" VerticalOptions="Center" />
                                <Label Text="▼" FontSize="10" TextColor="#A1A1AA" VerticalOptions="Center" Margin="5,0,0,0"/>
                            </HorizontalStackLayout>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSelectPeriodTapped" />
                            </Frame.GestureRecognizers>
                        </Frame>
                    </Grid>

                    <!-- BLOC GRAPHIQUE (Temps total & Graphique par jour) -->
                    <Frame BackgroundColor="#121212" CornerRadius="16" HasShadow="False" Padding="20" BorderColor="Transparent">
                        <VerticalStackLayout Spacing="20">
                            <!-- Titre du graphique (lié au ViewModel) -->
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding TotalStudyTime}" FontSize="26" FontAttributes="Bold" TextColor="White" />
                                <Label Text="Temps total pour la période" FontSize="13" TextColor="#A1A1AA" />
                            </VerticalStackLayout>

                            <!-- Sessions terminées count -->
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Sessions terminées :" FontSize="13" TextColor="#A1A1AA" />
                                <Label Text="{Binding CompletedSessionsCount}" FontSize="13" FontAttributes="Bold" TextColor="#4ADE80" />
                            </HorizontalStackLayout>

                            <!-- Graphique en barres des heures d'études passées par jour -->
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*" HeightRequest="120" ColumnSpacing="10" VerticalOptions="End" Margin="0,15,0,0">
                                <!-- Lundi -->
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="End" Spacing="8">
                                    <Border BackgroundColor="#4ADE80" Stroke="Transparent" StrokeShape="RoundRectangle 6" WidthRequest="22" HeightRequest="{Binding MondayHeight}" HorizontalOptions="Center" VerticalOptions="End" />
                                    <Label Text="L" FontSize="11" TextColor="#A1A1AA" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <!-- Mardi -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="End" Spacing="8">
                                    <Border BackgroundColor="#4ADE80" Stroke="Transparent" StrokeShape="RoundRectangle 6" WidthRequest="22" HeightRequest="{Binding TuesdayHeight}" HorizontalOptions="Center" VerticalOptions="End" />
                                    <Label Text="M" FontSize="11" TextColor="#A1A1AA" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <!-- Mercredi -->
                                <VerticalStackLayout Grid.Column="2" VerticalOptions="End" Spacing="8">
                                    <Border BackgroundColor="#4ADE80" Stroke="Transparent" StrokeShape="RoundRectangle 6" WidthRequest="22" HeightRequest="{Binding WednesdayHeight}" HorizontalOptions="Center" VerticalOptions="End" />
                                    <Label Text="M" FontSize="11" TextColor="#A1A1AA" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <!-- Jeudi -->
                                <VerticalStackLayout Grid.Column="3" VerticalOptions="End" Spacing="8">
                                    <Border BackgroundColor="#4ADE80" Stroke="Transparent" StrokeShape="RoundRectangle 6" WidthRequest="22" HeightRequest="{Binding ThursdayHeight}" HorizontalOptions="Center" VerticalOptions="End" />
                                    <Label Text="J" FontSize="11" TextColor="#A1A1AA" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <!-- Vendredi -->
                                <VerticalStackLayout Grid.Column="4" VerticalOptions="End" Spacing="8">
                                    <Border BackgroundColor="#4ADE80" Stroke="Transparent" StrokeShape="RoundRectangle 6" WidthRequest="22" HeightRequest="{Binding FridayHeight}" HorizontalOptions="Center" VerticalOptions="End" />
                                    <Label Text="V" FontSize="11" TextColor="#A1A1AA" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <!-- Samedi -->
                                <VerticalStackLayout Grid.Column="5" VerticalOptions="End" Spacing="8">
                                    <Border BackgroundColor="#4ADE80" Stroke="Transparent" StrokeShape="RoundRectangle 6" WidthRequest="22" HeightRequest="{Binding SaturdayHeight}" HorizontalOptions="Center" VerticalOptions="End" />
                                    <Label Text="S" FontSize="11" TextColor="#A1A1AA" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <!-- Dimanche -->
                                <VerticalStackLayout Grid.Column="6" VerticalOptions="End" Spacing="8">
                                    <Border BackgroundColor="#4ADE80" Stroke="Transparent" StrokeShape="RoundRectangle 6" WidthRequest="22" HeightRequest="{Binding SundayHeight}" HorizontalOptions="Center" VerticalOptions="End" />
                                    <Label Text="D" FontSize="11" TextColor="#A1A1AA" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- HISTORIQUE DES SESSIONS (Dynamique) -->
                    <VerticalStackLayout Spacing="15">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <BoxView Color="#4ADE80" WidthRequest="6" HeightRequest="6" CornerRadius="3" VerticalOptions="Center" />
                            <Label Text="HISTORIQUE DES SESSIONS" FontSize="10" FontAttributes="Bold" TextColor="#A1A1AA" CharacterSpacing="1" />
                        </HorizontalStackLayout>

                        <!-- CollectionView des sessions de révision -->
                        <CollectionView ItemsSource="{Binding SessionHistory}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:StudySessionRecord">
                                    <Frame BackgroundColor="#121212" CornerRadius="12" Padding="15" Margin="0,4" HasShadow="False" BorderColor="Transparent">
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15" VerticalOptions="Center">
                                            <Frame Grid.Column="0" 
                                                   BackgroundColor="{Binding SubjectColor}" 
                                                   CornerRadius="8" 
                                                   HeightRequest="30" 
                                                   WidthRequest="30" 
                                                   Padding="0" 
                                                   HasShadow="False" 
                                                   BorderColor="Transparent" 
                                                   VerticalOptions="Center" 
                                                   HorizontalOptions="Center">
                                                <Label Text="{Binding SubjectInitial}" 
                                                       FontSize="12" 
                                                       FontAttributes="Bold" 
                                                       TextColor="White" 
                                                       HorizontalOptions="Center" 
                                                       VerticalOptions="Center" />
                                            </Frame>
                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding SubjectName}" FontSize="14" FontAttributes="Bold" TextColor="White" />
                                                <Label Text="{Binding CompletedAt, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="11" TextColor="#A1A1AA" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding DurationMinutes, StringFormat='{0} min'}" FontSize="13" FontAttributes="Bold" TextColor="#4ADE80" VerticalOptions="Center" />
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- Barre de navigation flottante -->
            <Frame VerticalOptions="End"
                   BackgroundColor="#27272A"
                   CornerRadius="35"
                   HasShadow="True"
                   Margin="20, 0, 20, 20"
                   Padding="15, 6"
                   BorderColor="Transparent">
                <Grid ColumnDefinitions="*, *, *">
                    <!-- Accueil -->
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                        <ImageButton Source="timer.svg" HeightRequest="14" WidthRequest="14" Padding="0" BackgroundColor="Transparent" Clicked="OnNavigateHome" />
                        <Label Text="Accueil" FontSize="11" TextColor="#A1A1AA" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Statistiques (Actif) -->
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                        <ImageButton Source="statistics_active.svg" HeightRequest="14" WidthRequest="14" Padding="0" BackgroundColor="Transparent" />
                        <Label Text="Statistiques" FontSize="11" TextColor="#4ADE80" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Paramètres -->
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                        <ImageButton Source="settings.svg" HeightRequest="14" WidthRequest="14" Padding="0" BackgroundColor="Transparent" Clicked="OnNavigateSettings" />
                        <Label Text="Paramètres" FontSize="11" TextColor="#A1A1AA" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>

        </Grid>
    </Grid>
</ContentPage>
