<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyTimer.Views.SettingsPage"
             BackgroundColor="#000000"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">

        <!-- ======================================= -->
        <!-- 1. EN-TÊTE FIXE (Ligne 0)               -->
        <!-- ======================================= -->
        <Grid Grid.Row="0" 
              ColumnDefinitions="*, Auto, *" 
              Padding="20, 15, 20, 10" 
              BackgroundColor="Transparent"
              ZIndex="1">

            <!-- Bouton Retour -->
            <Frame Grid.Column="0" 
                   BackgroundColor="#121212" 
                   CornerRadius="16" 
                   HeightRequest="32" 
                   WidthRequest="32" 
                   Padding="0" 
                   HasShadow="False" 
                   HorizontalOptions="Start" 
                   VerticalOptions="Center">
                <ImageButton Source="back_icon.png" 
                             HeightRequest="14" 
                             WidthRequest="14" 
                             HorizontalOptions="Center" 
                             VerticalOptions="Center" 
                             BackgroundColor="Transparent" 
                             Clicked="OnBackClicked" />
            </Frame>

            <!-- Pilule Centrale (Logo + Titre "Paramètres") -->
            <Frame Grid.Column="1" 
                   BackgroundColor="#121212" 
                   CornerRadius="20" 
                   Padding="20,8" 
                   HasShadow="False" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center" 
                   BorderColor="Transparent">
                <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Image Source="studytimerlogo.png" HeightRequest="16" WidthRequest="16" VerticalOptions="Center"/>
                        <Label Text="StudyTimer" FontSize="14" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Paramètres" FontSize="10" TextColor="#A1A1AA" HorizontalOptions="Center" Margin="0,2,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Avatar Utilisateur -->
            <Frame Grid.Column="2" 
                   BackgroundColor="#121212" 
                   CornerRadius="16" 
                   HeightRequest="32" 
                   WidthRequest="32" 
                   Padding="0" 
                   HasShadow="False" 
                   HorizontalOptions="End" 
                   VerticalOptions="Center">
                <Image Source="avatar_placeholder.png" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
        </Grid>

        <!-- ======================================= -->
        <!-- 2. CONTENU + BARRE FLOTTANTE (Ligne 1)  -->
        <!-- ======================================= -->
        <Grid Grid.Row="1">

            <!-- LE CONTENU QUI DÉFILE (Liste des paramètres) -->
            <ScrollView Padding="20, 25, 20, 110">
                <VerticalStackLayout Spacing="15">

                    <!-- Option : Notifications -->
                    <Frame BackgroundColor="#121212" CornerRadius="12" Padding="15" HasShadow="False" BorderColor="Transparent">
                        <Grid ColumnDefinitions="Auto, *">
                            <!-- Tu pourras remplacer ces images par tes icônes SVG -->
                            <Image Grid.Column="0" Source="bell_icon.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" Margin="0,0,15,0"/>
                            <Label Grid.Column="1" Text="Notifications" FontSize="15" TextColor="White" VerticalOptions="Center" />
                        </Grid>
                        <!-- Effet de clic -->
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingTapped" />
                        </Frame.GestureRecognizers>
                    </Frame>

                    <!-- Option : Durée des pauses -->
                    <Frame BackgroundColor="#121212" CornerRadius="12" Padding="15" HasShadow="False" BorderColor="Transparent">
                        <Grid ColumnDefinitions="Auto, *">
                            <Image Grid.Column="0" Source="clock_icon.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" Margin="0,0,15,0"/>
                            <Label Grid.Column="1" Text="Durée des pauses" FontSize="15" TextColor="White" VerticalOptions="Center" />
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingTapped" />
                        </Frame.GestureRecognizers>
                    </Frame>

                    <!-- Option : Mode sombre -->
                    <Frame BackgroundColor="#121212" CornerRadius="12" Padding="15" HasShadow="False" BorderColor="Transparent">
                        <Grid ColumnDefinitions="Auto, *">
                            <Image Grid.Column="0" Source="moon_icon.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" Margin="0,0,15,0"/>
                            <Label Grid.Column="1" Text="Mode sombre" FontSize="15" TextColor="White" VerticalOptions="Center" />
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingTapped" />
                        </Frame.GestureRecognizers>
                    </Frame>

                    <!-- Option : À propos -->
                    <Frame BackgroundColor="#121212" CornerRadius="12" Padding="15" HasShadow="False" BorderColor="Transparent">
                        <Grid ColumnDefinitions="Auto, *">
                            <Image Grid.Column="0" Source="dots_icon.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" Margin="0,0,15,0"/>
                            <Label Grid.Column="1" Text="À propos" FontSize="15" TextColor="White" VerticalOptions="Center" />
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSettingTapped" />
                        </Frame.GestureRecognizers>
                    </Frame>

                    <!-- Option : Se déconnecter (Texte et Icône en Rouge) -->
                    <Frame BackgroundColor="#121212" CornerRadius="12" Padding="15" HasShadow="False" BorderColor="Transparent">
                        <Grid ColumnDefinitions="Auto, *">
                            <Image Grid.Column="0" Source="logout_icon.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" Margin="0,0,15,0"/>
                            <Label Grid.Column="1" Text="Se déconnecter" FontSize="15" TextColor="#EF4444" VerticalOptions="Center" />
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLogoutTapped" />
                        </Frame.GestureRecognizers>
                    </Frame>

                </VerticalStackLayout>
            </ScrollView>

            <!-- ======================================= -->
            <!-- LA BARRE DE NAVIGATION FLOTTANTE        -->
            <!-- ======================================= -->
            <!-- L'onglet actif est maintenant "Paramètres" (Vert) -->
            <Frame VerticalOptions="End" 
                   BackgroundColor="#27272A" 
                   CornerRadius="35" 
                   HasShadow="True" 
                   Margin="20, 0, 20, 20" 
                    Padding="15, 6" 
                   BorderColor="Transparent">
                <Grid ColumnDefinitions="*, *, *">
                    <!-- Accueil (Inactif) -->
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                        <ImageButton Source="timer.svg" HeightRequest="12" WidthRequest="12" Padding="0" BackgroundColor="Transparent" Clicked="OnNavigateHome" />
                        <Label Text="Accueil" FontSize="11" TextColor="#A1A1AA" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Statistiques (Inactif) -->
                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                        <ImageButton Source="statistics.svg" HeightRequest="12" WidthRequest="12" Padding="0" BackgroundColor="Transparent" Clicked="OnNavigateStats" />
                        <Label Text="Statistiques" FontSize="11" TextColor="#A1A1AA" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Paramètres (Actif -> Vert) -->
                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                        <ImageButton Source="settings_active.svg" HeightRequest="12" WidthRequest="12" Padding="0" BackgroundColor="Transparent" />
                        <Label Text="Paramètres" FontSize="11" TextColor="#4ADE80" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>

        </Grid>
    </Grid>
</ContentPage>