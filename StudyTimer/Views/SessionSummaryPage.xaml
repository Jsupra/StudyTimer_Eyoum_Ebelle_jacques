<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyTimer.Views.SessionSummaryPage"
             BackgroundColor="#000000"
             Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView Padding="25, 60, 25, 40">
            <VerticalStackLayout Spacing="30" VerticalOptions="Center">

                <!-- Illustration de succès (Trophée, Check ou Étoile) -->
                <Image Source="success_icon.png" 
                       HeightRequest="120" 
                       WidthRequest="120" 
                       HorizontalOptions="Center" 
                       Margin="0,0,0,10"/>

                <!-- Titre de célébration -->
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="Session terminée !" 
                           FontSize="28" 
                           FontAttributes="Bold" 
                           TextColor="White" 
                           HorizontalOptions="Center" />
                    <Label Text="Excellent travail. Vos métriques ont été mises à jour." 
                           FontSize="14" 
                           TextColor="#A1A1AA" 
                           HorizontalOptions="Center" 
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Carte de résumé de la session -->
                <Frame BackgroundColor="#121212" CornerRadius="16" HasShadow="False" Padding="20" BorderColor="Transparent" Margin="0,15,0,20">
                    <VerticalStackLayout Spacing="20">

                        <!-- Matière -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Matière" FontSize="13" TextColor="#A1A1AA" VerticalOptions="Center" />
                            <Label x:Name="SubjectLabel" Grid.Column="1" Text="ALGORITHMIQUE" FontSize="13" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#27272A" />

                        <!-- Temps de focus total -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Temps de focus" FontSize="13" TextColor="#A1A1AA" VerticalOptions="Center" />
                            <Label x:Name="TimeLabel" Grid.Column="1" Text="1h 40min" FontSize="13" FontAttributes="Bold" TextColor="#4ADE80" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#27272A" />

                        <!-- Cycles complétés -->
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Cycles complétés" FontSize="13" TextColor="#A1A1AA" VerticalOptions="Center" />
                            <Label x:Name="CyclesLabel" Grid.Column="1" Text="4 cycles" FontSize="13" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- Bouton de retour au tableau de bord -->
                <Button Text="Retourner à l'accueil" 
                        TextColor="Black" 
                        BackgroundColor="#4ADE80" 
                        FontAttributes="Bold" 
                        HeightRequest="55" 
                        CornerRadius="27" 
                        Clicked="OnReturnHomeClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>